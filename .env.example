# Canonical/sitemap origin only; no external request or deployment.
NEXT_PUBLIC_SITE_URL=https://apexnewsindia.com

# Public source reference only. The adapter pins its read-only origin in lib/wordpress/html.ts.
NEXT_PUBLIC_SOURCE_SITE=https://apexnewsindia.in
SOURCE_WP_API=https://apexnewsindia.in/wp-json/wp/v2

# Read-only Hindi source harness at /source-preview only. /en and /roman remain mock-backed.
USE_WORDPRESS_CONTENT=false

# Server-only translation provider. No automatic provider/model fallback.
TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set true only for a Google project confirmed to have billing disabled.
# The API cannot determine/enforce free billing for a paid Google project.
GEMINI_FREE_TIER_CONFIRMED=false
# Localization state, ignored by version control. Never under public/.
# Development default:
LOCALIZATION_DATA_DIR=.data/localization
# Production should use an absolute persistent path OUTSIDE versioned releases,
# e.g. /home/<user>/domains/apexnewsindia.com/data/localization
